---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const BASE = '/SoCal-Super-Standards';
const path = Astro.url.pathname;

const navItems = [
  { label: 'Topics', href: `${BASE}/topics/`, match: ['/topics/'] },
  { label: 'Details', href: `${BASE}/details/`, match: ['/details/', '/keywords/'] },
  { label: 'Signs', href: `${BASE}/signs/`, match: ['/signs/'] },
  { label: 'Markings', href: `${BASE}/markings/`, match: ['/markings/'] },
  { label: 'Bulletins', href: `${BASE}/bulletins/`, match: ['/bulletins/'] },
  { label: 'CA MUTCD', href: `${BASE}/ca-mutcd/`, match: ['/ca-mutcd/', '/mutcd/'] },
  { label: 'Caltrans', href: `${BASE}/caltrans/standard-plans-2026/`, match: ['/caltrans/'] },
  { label: 'LADOT', href: `${BASE}/ladot/`, match: ['/ladot/'] },
  { label: 'Cities', href: `${BASE}/long-beach/standard-plans/`, match: ['/burbank/', '/pasadena/', '/long-beach/', '/palmdale/', '/torrance/', '/gardena/', '/glendora/', '/santa-monica/', '/west-hollywood/', '/culver-city/'] },
  { label: 'Guides', href: `${BASE}/guides/`, match: ['/guides/', '/fhwa/', '/ada/'] },
  { label: 'Ask AI', href: `${BASE}/ask/`, match: ['/ask/'] },
];

const relPath = path.startsWith(BASE) ? path.slice(BASE.length) || '/' : path;
const isActive = (prefixes: string[]) => prefixes.some((p) => relPath === p || relPath.startsWith(p));
---

<div class="header sss-header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <nav class="sss-topnav print:hidden" aria-label="Main sections">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={['sss-navlink', { active: isActive(item.match) }]}
        aria-current={isActive(item.match) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
  <div class="sl-flex print:hidden sss-search-slot"><Search /></div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons"><SocialIcons /></div>
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: 0.6rem;
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }
    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      flex: 0 0 auto;
    }
    .sss-topnav {
      display: none;
      align-items: center;
      gap: 0.1rem;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .sss-topnav::-webkit-scrollbar {
      display: none;
    }
    .sss-navlink {
      padding: 0.26rem 0.44rem;
      border-radius: 7px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--sss-ink);
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.12s, color 0.12s;
    }
    .sss-navlink:hover {
      background: var(--sss-tan-2);
      color: var(--sss-green);
    }
    .sss-navlink.active {
      background: var(--sl-color-accent-low);
      color: var(--sss-green);
    }
    .sss-search-slot {
      flex: 1 1 auto;
      justify-content: flex-end;
      min-width: 0;
    }
    .right-group,
    .social-icons {
      gap: 0.6rem;
      align-items: center;
      flex: 0 0 auto;
    }
    @media (min-width: 56rem) {
      .sss-topnav {
        display: flex;
        flex: 1 1 auto;
      }
      .sss-search-slot {
        flex: 0 1 13rem;
      }
    }
    @media (min-width: 78rem) {
      .sss-navlink {
        padding: 0.3rem 0.56rem;
        font-size: 0.84rem;
      }
      .sss-search-slot {
        flex: 0 1 16.5rem;
      }
    }
  }
</style>
