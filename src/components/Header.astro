---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import { agencyCatalogVersion } from '../lib/agency-catalog';
const BASE = '/SoCal-Super-Standards';
const path = Astro.url.pathname;
const primary = [
  ['Guides','guides'], ['Topics','topics'], ['Municipalities','map'], ['Tools','tools'],
];
const directories = [
  ['Sign chart and downloads','signs'], ['Drawings and details','details'], ['Pavement markings','markings'],
  ['Federal MUTCD','mutcd'], ['California MUTCD','ca-mutcd'], ['Transit agency guides','transit'], ['Agency directory','regions'],
];
---
<div class="sss-header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <nav class="sss-topnav print:hidden" aria-label="Browse standards">
    {primary.map(([name,slug])=><a class="nav-primary" href={BASE+'/'+slug+'/'} aria-current={path.startsWith(BASE+'/'+slug+'/')?'location':undefined}>{name}</a>)}
    <details class="nav-menu" name="site-header-menu">
      <summary>Browse</summary>
      <div class="nav-dropdown">
        {primary.map(([name,slug])=><a class="nav-small" href={BASE+'/'+slug+'/'}>{name}</a>)}
        {directories.map(([name,slug])=><a href={BASE+'/'+slug+'/'}>{name}</a>)}
      </div>
    </details>
  </nav>
  <a class="sss-search-link" href={BASE+'/search/'} aria-label="Search all standards"><span>Search</span></a>
  <details class="nav-menu settings-menu" name="site-header-menu">
    <summary><span data-workspace-name>Settings</span></summary>
    <div class="nav-dropdown">
      <label>City or agency<select id="agency-mode" aria-label="Choose city or agency"><option value="">All agencies</option></select></label>
      <label>Reading width<select data-pref="width"><option value="auto">Adaptive</option><option value="narrow">Narrow</option><option value="wide">Wide</option></select></label>
      <label>Navigation panels<select data-pref="panels"><option value="auto">Show sidebars</option><option value="focus">Focus on document</option></select></label>
      <label>Figure columns<select data-pref="grid"><option value="auto">Automatic</option><option value="1">One</option><option value="2">Two</option><option value="3">Three</option></select></label>
      <label>Sheet scale<select data-pref="scale"><option value="100">Fit</option><option value="75">75%</option><option value="125">125%</option><option value="150">150%</option></select></label>
      <button type="button" data-open-checks hidden>Checks and calculators</button>
      <a href="https://github.com/drzkid96/SoCal-Super-Standards">Site repository</a>
    </div>
  </details>
  <script is:inline src={BASE+'/js/agency-catalog-'+agencyCatalogVersion+'.js'}></script>
</div>
