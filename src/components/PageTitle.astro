---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import fs from 'node:fs';
import { agencies, type AgencyKey } from '../lib/agencies';
import { BASE, getPageNav } from '../lib/nav';

const entry = Astro.locals.starlightRoute.entry;
const id = (entry.id || '').replace(/\/index$/, '').replace(/^index$/, '');

const topicGroups = JSON.parse(fs.readFileSync('./data/topics.json', 'utf8')) as {
  group: string;
  topics: { slug: string; name: string }[];
}[];
const TOPIC_GROUP: Record<string, string> = {};
for (const g of topicGroups) {
  for (const t of g.topics) TOPIC_GROUP[t.slug] = g.group;
}

const LADOT_DOCS: Record<string, string> = {
  'mpp-531': 'MPP 531',
  'mpp-521': 'MPP 521',
  'red-book': 'Red Book',
  'supplemental-street-design-guide': 'Supp. Street Design Guide',
  'complete-streets': 'Complete Streets DG',
  'games-corridors': '2028 Games DG',
  'marked-crosswalks': 'Marked Crosswalk Guidelines',
  'cad-standards': 'CAD Drafting Standards',
  'parking': 'Parking Standards',
  'mobility-plan': 'Mobility Plan 2035',
  'signal-design-notes': 'Signal Design Notes',
  'geometric-plan-sample': 'Geometric Plan Sample',
  'curb-paint': 'Curb Paint & Red Curb',
};

type Crumb = { label: string; href?: string };
const crumbs: Crumb[] = [];

if (id && id !== '404') {
  const segs = id.split('/');
  const top = segs[0];
  crumbs.push({ label: 'Home', href: `${BASE}/` });

  const agency = Object.hasOwn(agencies,top) ? agencies[top as AgencyKey] : undefined;
  if (agency || ['mutcd','ca-mutcd'].includes(top)) {
    crumbs.push({ label: 'Agencies', href: BASE+'/agencies/' });
    if (segs.length > 1 && agency) crumbs.push({label: agency.short, href: BASE+'/'+top+'/'});
    if (top === 'mutcd' || top === 'ca-mutcd') {
      const publisher = top === 'mutcd' ? 'fhwa' : 'caltrans';
      crumbs.push({label: agencies[publisher].short, href: BASE+'/'+publisher+'/'});
    }
  }
  if (top === 'topics') {
    if (segs.length > 1) {
      crumbs.push({ label: 'Topics', href: `${BASE}/topics/` });
      const grp = TOPIC_GROUP[segs[1]];
      if (grp) crumbs.push({ label: grp });
    }
  } else if (top === 'details') {
    if (segs.length > 1) {
      crumbs.push({ label: 'Detail & Drawing Index', href: `${BASE}/details/` });
      const agMap: Record<string, [string, string]> = {
        ladot: ['LADOT Drawings', `${BASE}/details/?sg=LADOT&type=Standard+drawing`],
        caltrans: ['Caltrans Standard Plans', `${BASE}/details/?sg=Caltrans&type=Standard+drawing`],
        burbank: ['Burbank Standard Plans', `${BASE}/details/?sg=Burbank&type=Standard+drawing`],
        pasadena: ['Pasadena Standard Plans', `${BASE}/details/?sg=Pasadena&type=Standard+drawing`],
      };
      const ag = agMap[segs[1]];
      if (ag) crumbs.push({ label: ag[0], href: ag[1] });
    }
  } else if (top === 'signs') {
    if (segs.length > 1) crumbs.push({ label: 'Sign Library', href: `${BASE}/signs/` });
  } else if (top === 'markings') {
    if (segs.length > 1) crumbs.push({ label: 'Pavement Markings', href: `${BASE}/markings/` });
  } else if (top === 'bulletins') {
    if (segs.length > 1) crumbs.push({ label: 'Bulletins & Policy Memos', href: `${BASE}/bulletins/` });
  } else if (top === 'ca-mutcd') {
    if (segs.length > 1) crumbs.push({ label: 'CA MUTCD 2026', href: `${BASE}/ca-mutcd/` });
  } else if (top === 'mutcd') {
    if (segs.length > 1) crumbs.push({ label: 'Federal MUTCD 11th Ed. R1', href: `${BASE}/mutcd/` });
  } else if (top === 'ladot') {
    if (segs.length > 1) {
      if (segs.length > 2 && LADOT_DOCS[segs[1]]) {
        crumbs.push({ label: LADOT_DOCS[segs[1]], href: `${BASE}/ladot/${segs[1]}/` });
      }
    }
  } else if (top === 'caltrans') {
    if (segs[1] === 'standard-plans-2026' && segs.length > 2) {
      crumbs.push({ label: 'Caltrans 2026 Standard Plans', href: `${BASE}/caltrans/standard-plans-2026/` });
    } else if (segs[1] === 'la28-supplement' && segs.length > 2) {
      crumbs.push({ label: 'LA28 Supplement', href: `${BASE}/caltrans/la28-supplement/` });
    }
  } else if (top === 'burbank' && segs.length > 2) {
    crumbs.push({ label: 'Burbank Standard Plans', href: `${BASE}/burbank/standard-plans/` });
  } else if (top === 'pasadena' && segs.length > 2) {
    crumbs.push({ label: 'Pasadena Standard Plans', href: `${BASE}/pasadena/standard-plans/` });
  } else if (['santa-monica', 'west-hollywood', 'culver-city', 'long-beach', 'palmdale', 'torrance', 'gardena', 'glendora'].includes(top)) {
    crumbs.push({ label: 'LA County Cities', href: `${BASE}/cities/` });
  } else if (top === 'fhwa') {
    if (segs.length > 2) {
      const label = segs[1] === 'step-uncontrolled-crossings' ? 'FHWA STEP Guide' : 'FHWA Interchange Promptlist';
      crumbs.push({ label, href: `${BASE}/fhwa/${segs[1]}/` });
    }
  } else if (top === 'ada') {
    if (segs.length > 2) {
      crumbs.push({ label: 'ADA Guide Ch. 4', href: `${BASE}/ada/curb-ramps/` });
    }
  } else if (top === 'guides') {
    if (segs.length > 1) crumbs.push({ label: 'National Design Guides', href: `${BASE}/guides/` });
  } else if (top === 'aashto') {
    crumbs.push({ label: 'National Design Guides', href: `${BASE}/guides/` });
    if (segs.length > 2) crumbs.push({ label: 'AASHTO Bike Guide (5th Ed.)', href: `${BASE}/guides/aashto-bike-guide/` });
  }
}

const activeHub = Object.hasOwn(agencies, id) ? agencies[id as AgencyKey] : undefined;
const nav = id && id !== '404' ? getPageNav(id) : undefined;
---

{id && id !== '404' && (
  <div class="sss-topbar print:hidden">
    <div class="sss-hist" aria-label="Session navigation">
      <button type="button" class="sss-hbtn" data-nav-back title="Go back (browser history)">&larr; Back</button>
      <button type="button" class="sss-hbtn" data-nav-fwd title="Go forward (browser history)">Fwd &rarr;</button>
      <div class="sss-recent-wrap">
        <button type="button" class="sss-hbtn sss-recent-btn" data-recent-toggle aria-expanded="false" title="Recently visited pages in this tab">Recent &#9662;</button>
        <div class="sss-recent-menu" hidden role="menu"></div>
      </div>
    </div>
    {crumbs.length > 0 && (
      <nav class="crumb sss-crumb" aria-label="Breadcrumb">
        {crumbs.map((c, idx) => (
          <>
            {idx > 0 && <span class="crumb-sep" aria-hidden="true">&rsaquo;</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </>
        ))}
      </nav>
    )}
  </div>
)}
{activeHub ? (
  <div class="agency-heading" data-agency={id}>
    <p>{activeHub.agency}</p>
    <DefaultPageTitle />
    <a href={activeHub.official}>Agency website</a>
  </div>
) : <DefaultPageTitle />}
{nav && (nav.prev || nav.next) && (
  <nav class="sss-seqbar print:hidden" aria-label="Previous and next page">
    <span class="sss-seq-prev">
      {nav.prev && <a href={nav.prev.href} rel="prev" title="Previous ([)">&larr; {nav.prev.label}</a>}
    </span>
    <span class="sss-seq-up">
      {nav.up && <a href={nav.up.href}>{nav.up.label}</a>}
    </span>
    <span class="sss-seq-next">
      {nav.next && <a href={nav.next.href} rel="next" title="Next (])">{nav.next.label} &rarr;</a>}
    </span>
  </nav>
)}
