---
import { BASE, getPageNav } from '../lib/nav';

const id = (Astro.locals.starlightRoute.entry.id || '').replace(/\/index$/, '');
const nav = getPageNav(id);
const chapter = /^(ca-mutcd|mutcd)\/[^/]+$/.test(id) ||
  (/^(ladot|caltrans|fhwa|ada|boe|burbank|pasadena)\/.+\/.+/.test(id) && !id.includes('plan-reference'));
const parent = id.slice(0, id.lastIndexOf('/') + 1);
const sameBook = (href?: string) => href?.startsWith(BASE + '/' + parent);
---
{chapter && (sameBook(nav?.prev?.href) || sameBook(nav?.next?.href)) && (
  <nav class="chapter-turns print:hidden" aria-label="Adjacent chapters">
    {nav?.prev && sameBook(nav.prev.href) && <a href={nav.prev.href} rel="prev">← {nav.prev.label}</a>}
    {nav?.next && sameBook(nav.next.href) && <a href={nav.next.href} rel="next">{nav.next.label} →</a>}
  </nav>
)}
